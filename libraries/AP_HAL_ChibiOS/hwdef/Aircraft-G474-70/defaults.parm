CAN_PROTOCOL 1
CAN2_BAUDRATE 1000000
CAN2_PROTOCOL 1
CAN_MIRROR_PORTS 3
CAN_SLCAN_CPORT 0
GPS1_TYPE 0
GPS_PORT 2
ARSPD_TYPE 1
PRX_PORT 1
PRX_BAUDRATE 921600
PRX1_TYPE 8
PRX1_ADDR 0
RNGFND_PORT 4
RNGFND_BAUDRATE 115200
RNGFND1_TYPE 11
RNGFND1_MIN 0.5
RNGFND1_MAX 50.0
RNGFND_MAX_RATE 100

# No actuator outputs assigned on the avionics node.
OUT1_FUNCTION 0
OUT2_FUNCTION 0
OUT3_FUNCTION 0
OUT4_FUNCTION 0
OUT5_FUNCTION 0
OUT6_FUNCTION 0
OUT7_FUNCTION 0
OUT8_FUNCTION 0
OUT9_FUNCTION 0
OUT10_FUNCTION 0
OUT11_FUNCTION 0
