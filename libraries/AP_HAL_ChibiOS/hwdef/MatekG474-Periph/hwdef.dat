include ../MatekG474/hwdef.inc

# This MatekG474-Periph image enables only the configured GPS, airspeed,
# SF45/B, and US-D1 sensor paths. Disable unrelated peripheral families.
define AP_PERIPH_GPS_ENABLED 1
define GPS_MAX_RATE_MS 200
define GPS_MAX_RECEIVERS 1
define GPS_MAX_INSTANCES 1
define HAL_PERIPH_GPS_PORT_DEFAULT 2
define HAL_GPS1_TYPE_DEFAULT 1
define AP_PERIPH_MAG_ENABLED 0
define AP_PERIPH_AIRSPEED_ENABLED 1
define HAL_AIRSPEED_TYPE_DEFAULT 1
define AIRSPEED_MAX_SENSORS 1
define AP_AIRSPEED_BACKEND_DEFAULT_ENABLED 0
define AP_AIRSPEED_MS4525_ENABLED 1
define AP_AIRSPEED_AUTOCAL_ENABLE 0
define AP_PERIPH_BARO_ENABLED 0
define AP_PERIPH_BATTERY_ENABLED 0
define AP_PERIPH_MSP_ENABLED 0
define HAL_MSP_ENABLED 0
define AP_PERIPH_ADSB_ENABLED 0
define AP_PERIPH_RCIN_ENABLED 0
define AP_PERIPH_EFI_ENABLED 0

# SF45/B proximity sensor and its raw-sample DroneCAN extension.
define AP_PERIPH_PROXIMITY_ENABLED 1
define HAL_PROXIMITY_ENABLED 1
define AP_PROXIMITY_SF45_CAN_ENABLED 1

# US-D1 serial rangefinder.
define AP_PERIPH_RANGEFINDER_ENABLED 1

# Reset old MatekG474-Periph settings once so these defaults are applied.
define AP_PERIPH_PARAM_FORMAT_VERSION 4
