# Fixed DroneCAN identity and classic CAN bitrate for the paired PX4 build.
CAN_NODE       42
CAN_BAUDRATE   1000000
CAN_SLCAN_CPORT 0

# GPS defaults to automatic protocol detection on UART2.
GPS_PORT       2
GPS1_TYPE      1

# Matek ASPD-4525 (MS4525D0) on I2C1.
ARSPD_TYPE     1

# SF45/B on USART1 and US-D1 on UART4.
PRX_PORT       1
PRX_BAUDRATE 921600
PRX1_TYPE    8
PRX1_ADDR    0
RNGFND_PORT    4
RNGFND_BAUDRATE 115200
RNGFND1_TYPE 11
RNGFND_MAX_RATE 100

