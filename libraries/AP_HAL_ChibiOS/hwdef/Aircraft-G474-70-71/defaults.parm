# Combined 70/71 role: one physical device, CAN_NODE 70.
# Node 70: SF45/B UART1, US-D1 UART4, Here4 on mirrored CAN2.
CAN_NODE 70
CAN_BAUDRATE 1000000
CAN_PROTOCOL 1
CAN2_BAUDRATE 1000000
CAN2_PROTOCOL 1
CAN_MIRROR_PORTS 3
CAN_SLCAN_CPORT 0
GPS1_TYPE 0
GPS_PORT 2
ARSPD_TYPE 1
PRX_PORT 1
PRX_BAUDRATE 921600
PRX1_TYPE 8
PRX1_ADDR 0
RNGFND_PORT 4
RNGFND_BAUDRATE 115200
RNGFND1_TYPE 11
RNGFND1_MIN 0.5
RNGFND1_MAX 50.0
RNGFND_MAX_RATE 100
OUT1_FUNCTION 55
OUT2_FUNCTION 56
OUT3_FUNCTION 57
OUT4_FUNCTION 0
OUT5_FUNCTION 0
OUT6_FUNCTION 0
OUT7_FUNCTION 0
OUT8_FUNCTION 0
OUT9_FUNCTION 0
OUT10_FUNCTION 0
OUT11_FUNCTION 0

# Spray actuator defaults; wire actuator IDs 5/6/7, hardpoints 0/1.
OUT_RATE 50
ESC_PWM_TYPE 1
OUT1_MIN 1000
OUT1_MAX 2000
OUT1_TRIM 1500
OUT2_MIN 1000
OUT2_MAX 2000
OUT2_TRIM 1500
OUT3_MIN 1000
OUT3_MAX 2000
OUT3_TRIM 1500
SRV_CMD_TIME_OUT 200
RELAY1_FUNCTION 10
RELAY1_PIN 54
RELAY1_DEFAULT 0
RELAY1_INVERTED 0
RELAY2_FUNCTION 11
RELAY2_PIN 55
RELAY2_DEFAULT 0
RELAY2_INVERTED 0
