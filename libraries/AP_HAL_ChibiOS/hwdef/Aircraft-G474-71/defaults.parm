# Dedicated spray actuator identity; bidirectional CAN1/CAN2 forwarding.
CAN_NODE 71
CAN_BAUDRATE 1000000
CAN_PROTOCOL 1
CAN2_BAUDRATE 1000000
CAN2_PROTOCOL 1
CAN_MIRROR_PORTS 3
CAN_SLCAN_CPORT 0

# Conventional servo-style PWM, provisional 50 Hz and 1000-2000 us range.
# RCIN5/6/7 map to wire actuator IDs 5/6/7, not propulsion RawCommand slots.
OUT_RATE 50
ESC_PWM_TYPE 1
OUT1_FUNCTION 55
OUT2_FUNCTION 56
OUT3_FUNCTION 57
OUT1_MIN 1000
OUT1_MAX 2000
OUT1_TRIM 1500
OUT2_MIN 1000
OUT2_MAX 2000
OUT2_TRIM 1500
OUT3_MIN 1000
OUT3_MAX 2000
OUT3_TRIM 1500
SRV_CMD_TIME_OUT 200

# Hardpoint IDs 0 and 1; GPIO low until commanded.
RELAY1_FUNCTION 10
RELAY1_PIN 54
RELAY1_DEFAULT 0
RELAY1_INVERTED 0
RELAY2_FUNCTION 11
RELAY2_PIN 55
RELAY2_DEFAULT 0
RELAY2_INVERTED 0
